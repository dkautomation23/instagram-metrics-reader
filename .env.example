# Copy to .env and fill in. The real .env is git-ignored - never commit tokens.

# DEMO_MODE=true replays the recorded Graph API responses in fixtures/ and makes
# no network calls at all. Set it to false once the app below exists.
DEMO_MODE=true

# --- Meta app (developers.facebook.com) --------------------------------
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
# Must match the redirect URI whitelisted in Facebook Login settings.
OAUTH_REDIRECT_URI=https://localhost:8000/oauth/callback
META_GRAPH_VERSION=v21.0

# --- behaviour ----------------------------------------------------------
CACHE_PATH=cache.sqlite3
# How long a cached metric counts as fresh (seconds). Keeps you off rate limits.
CACHE_TTL_SECONDS=3600
# Refresh the 60-day token when it is this many days from expiring.
TOKEN_REFRESH_MARGIN_DAYS=7
# Older than this and a value is reported as stale instead of current.
STALE_AFTER_HOURS=48
REQUEST_TIMEOUT=20
MAX_RETRIES=3
